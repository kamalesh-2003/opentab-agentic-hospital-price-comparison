# OpenTab environment variables
# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# --- Anthropic (Claude) --- console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Bright Data --- brightdata.com -> Account settings -> API keys
BRIGHTDATA_API_KEY=
# Zone NAMES (not keys), from Proxies & Scraping -> your zones
BRIGHTDATA_SERP_ZONE=
BRIGHTDATA_UNLOCKER_ZONE=

# --- Apify --- console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=
APIFY_USERNAME=

# --- Elastic Serverless (Elasticsearch project) ---
# Elasticsearch endpoint, e.g. https://xxxx.es.us-west-2.aws.elastic.cloud
ELASTIC_URL=
# Encoded API key from Management -> API keys
ELASTIC_API_KEY=
# Kibana endpoint, e.g. https://xxxx.kb.us-west-2.aws.elastic.cloud
KIBANA_URL=

# --- Cartesia (voice) --- play.cartesia.ai -> API Keys (server-side only)
CARTESIA_API_KEY=

# --- Convex --- filled in automatically by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Convex dashboard -> Settings -> Deploy keys -> Production (for Vercel builds)
CONVEX_DEPLOY_KEY=

# --- Vercel (optional if you ran `vercel login`) --- vercel.com -> Settings -> Tokens
VERCEL_TOKEN=
