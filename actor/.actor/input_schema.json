{
  "title": "Hospital Price Transparency Parser input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "domain": { "title": "Hospital domain", "type": "string", "description": "e.g. ucsfhealth.org. Used to fetch https://<domain>/cms-hpt.txt", "editor": "textfield" },
    "fileUrl": { "title": "Price file URL", "type": "string", "description": "Direct machine-readable file URL (skips cms-hpt.txt discovery)", "editor": "textfield" },
    "codes": { "title": "Target codes", "type": "array", "description": "CPT/HCPCS codes to keep", "editor": "stringList" },
    "timeBudgetSec": { "title": "Time budget (seconds)", "type": "integer", "default": 60 },
    "byteBudgetMb": { "title": "Byte budget (MB)", "type": "integer", "default": 500 }
  }
}
